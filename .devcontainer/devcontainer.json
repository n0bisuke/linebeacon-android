{
  "name": "linebeacon-android",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  // linebotの待受ポートを公開。Codespacesの認証付きURLはLINEのWebhook取得が
  // できないため、PortパネルでPort Visibilityを「Public」に変更すること
  "forwardPorts": [65135],
  "portsAttributes": {
    "65135": { "label": "linebot webhook server", "onAutoForward": "output" }
  },
  "onCreateCommand": "bash .devcontainer/setup-android-sdk.sh",
  "remoteEnv": {
    "ANDROID_HOME": "/home/vscode/android-sdk",
    "PATH": "${containerEnv:PATH}:/home/vscode/android-sdk/platform-tools"
  },
  "postStartCommand": "sdkmanager --version >/dev/null 2>&1 || echo 'SDK未インストール: onCreateが失敗していないか確認してください'"
}
