# Ollama経由でClaude Codeを動かす設定のひな形(Git管理する)。shared-dev-environments 直下で cp .env.sample .env して実際の値を書くと、npm run newproject:* で各プロジェクトにコピーされる(.env は .gitignore 済み)。
# Anthropicのログインで使いたいときは .env の ANTHROPIC_ 行をコメントアウトする。
# Ollama Cloud にAPIキーで直接接続する(ホストのOllama不要)。キーは https://ollama.com/settings/keys で発行。
ANTHROPIC_BASE_URL=https://ollama.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=glm-5.3-flash:cloud
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.3-flash:cloud
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.3-flash:cloud
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5.3-flash:cloud
