# Messaging APIチャネルのChannel secret (LINE Developers Console → チャネル基本設定)
LINE_CHANNEL_SECRET=コピーしたシークレットを貼る

# (任意) 検知をLINEのトークに返信する場合のみ設定
# チャネルの「Messaging API」設定 → チャネルアクセストークン(長期)
# LINE_CHANNEL_ACCESS_TOKEN=

# (任意) ポートとWebhookパス。既定は 65135 / /webhook (0xFE6F)
# PORT=65135

# (任意) ログ・返信でHWIDをマスク表示。既定は1(マスク)。0で実HWIDを表示
# MASK_HWID=1
# WEBHOOK_PATH=/webhook
