# Messaging APIチャネルのChannel secret (LINE Developers Console → チャネル基本設定)
LINE_CHANNEL_SECRET=コピーしたシークレットを貼る

# チャネルの「Messaging API」設定 → チャネルアクセストークン(長期)
# 手順上は必須。検知の返信・'apk'のダウンロードURL返信・オウム返しに使用する
LINE_CHANNEL_ACCESS_TOKEN=コピーしたトークンを貼る

# (任意) ポートとWebhookパス。既定は 65135 / /webhook (0xFE6F)
# 2つのサーバーを同時に動かすときはPORTを分ける
# PORT=65135

# (任意) ログ・返信でHWIDをマスク表示。既定は1(マスク)。0で実HWIDを表示
# MASK_HWID=1
# WEBHOOK_PATH=/webhook

# --- obniz-server.js 専用(npm run start:obniz) ---
# obnizのID(obnizパッケージに渡すもの。例: 1234-5678)
OBNIZ_ID=obnizのIDを貼る
# obnizが発信するLINE Simple BeaconのHWID(10桁HEX)。
# LINE Official Account Managerで発行・登録済みのものを使う
LINE_BEACON_HWID=0102030405